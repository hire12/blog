// schema.prisma

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  avatar    String   // URL for the avatar image
  createdAt DateTime @default(now()) // Automatically set the created date
  updatedAt DateTime @updatedAt      // Automatically updated when modified
  // articles  Article[] // Relation to the Article model
}

model Article {
  id          String   @id @default(uuid())
  title       String
  description String
  image       String
  category    String
  link        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model Vehicle {
  id           String   @id @default(uuid())
  licensePlate String   @unique
  model        String
  year         Int
  fuelType     String
  vehicleType  String  // Add this field for vehicle type
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}